# =============================================================================
# Nevark MSS — Production Environment Variables
# Copy this file to .env and fill in real values before first run.
# NEVER commit .env to version control.
# =============================================================================

# ── Host ─────────────────────────────────────────────────────────────────────
# IP or hostname where Nginx is reachable (office LAN IP or VPS domain)
HOST_IP=192.168.1.100

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=nevark-mss
APP_VERSION=1.0.0
DEBUG=false

# ── JWT (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=CHANGE_ME_USE_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=nevark_mss
POSTGRES_USER=nevark
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
# DATABASE_URL and REDIS_URL are assembled in docker-compose from the above vars

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_minio_user
MINIO_SECRET_KEY=CHANGE_ME_minio_password_min12chars
MINIO_BUCKET_NAME=nevark-mss
MINIO_SECURE=false

# ── Database pool ─────────────────────────────────────────────────────────────
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── OpenAI (leave blank if not using AI features) ────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── ChromaDB (internal service name — do not change) ─────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=nevark_mss
