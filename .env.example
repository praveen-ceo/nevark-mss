# =============================================================================
# Nevark MSS — Environment Variables
# Copy this file to .env and fill in every value before running Docker.
# NEVER commit .env to version control.
# =============================================================================


# ── Host ──────────────────────────────────────────────────────────────────────
# The IP address or domain name of the machine running Docker.
# Used for CORS and for the frontend to know where to send API calls.
# - Local machine : find with `ipconfig` (Windows) or `ifconfig` (Mac/Linux)
# - LAN server    : the LAN IP  e.g. 192.168.1.50
# - VPS / cloud   : the public IP or domain e.g. 203.0.113.10
HOST_IP=192.168.1.100


# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
# Choose "Session mode" (port 5432) and prefix with postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres


# ── Supabase Storage ──────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key (NOT the anon key)

# Name of the private storage bucket (must match what you created in Supabase)
MINIO_BUCKET_NAME=nevark-mss


# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# ── Redis ─────────────────────────────────────────────────────────────────────
# Choose any strong password — Redis runs inside Docker (not exposed externally)
REDIS_PASSWORD=CHANGE_ME_strong_redis_password


# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Internal service — do not change host/port (matched to docker-compose service name)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=nevark_mss


# ── Database connection pool ──────────────────────────────────────────────────
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20


# ── OpenAI (optional — leave blank to disable AI features) ───────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
